+function sameConnectionTarget(left: RegistryConnection, right: RegistryConnection): boolean {
+  if (
+    (left.kind === 'remote' || left.kind === 'cloud') &&
+    (right.kind === 'remote' || right.kind === 'cloud')
+  ) {
+    try {
+      return normalizeRemoteBaseUrl(left.url) === normalizeRemoteBaseUrl(right.url)
+    } catch {
+      return false
+    }
+  }
+
+  if (left.kind !== 'ssh' || right.kind !== 'ssh') {
+    return false
+  }
+
+  const key = (connection: RegistryConnection) =>
+    `${String(connection.user || '').trim().toLowerCase()}@` +
+    `${String(connection.host || '').trim().toLowerCase()}:` +
+    `${connection.port || 22}::${String(connection.remoteProfile || '').trim()}`
+
+  return key(left) === key(right)
+}
+
+function migratedGlobalConnection(v1: unknown): RegistryConnection {
+  const migrated = migrateV1ToRegistry(v1)
+
+  return (
+    migrated.connections.find(connection => connection.id === migrated.primary) ||
+    migrated.connections.find(connection => connection.kind === 'local')!
+  )
+}
+
+/**
+ * Keep the v2 registry aligned when the legacy connection-mode form writes
+ * connection.json after connections.json has already been created.
+ *
+ * First-run startup reads the registry before showing the Local/Remote choice,
+ * so the one-time migration has already persisted a local-only registry by the
+ * time an OIDC remote is applied. Without this reconciliation, the remote
+ * connection resumes successfully but Sessions immediately restores the stale
+ * local primary and starts the Python installer.
+ */
+export function reconcileV1GlobalConnection(
+  registry: ConnectionRegistry,
+  nextV1: unknown,
+  options: { activate?: boolean; previousV1?: unknown } = {}
+): ConnectionRegistry {
+  const candidate = migratedGlobalConnection(nextV1)
+
+  if (candidate.kind === 'local') {
+    return {
+      ...registry,
+      primary: LOCAL_CONNECTION_ID,
+      ...(options.activate ? { lastUsed: LOCAL_CONNECTION_ID } : {})
+    }
+  }
+
+  const previous = options.previousV1 === undefined ? null : migratedGlobalConnection(options.previousV1)
+  const existing =
+    registry.connections.find(connection => sameConnectionTarget(connection, candidate)) ||
+    (previous && previous.kind !== 'local'
+      ? registry.connections.find(connection => sameConnectionTarget(connection, previous))
+      : undefined)
+
+  let selected: RegistryConnection
+  let connections: RegistryConnection[]
+
+  if (existing) {
+    selected = {
+      ...candidate,
+      id: existing.id,
+      label: existing.label,
+      // Access-proxy headers are editable only in the v2 registry UI. A
+      // legacy Gateway Settings save for the same URL must not erase them.
+      ...(candidate.headers === undefined && existing.headers !== undefined ? { headers: existing.headers } : {}),
+      // Cloud org is likewise registry-only in some edit flows.
+      ...(candidate.kind === 'cloud' &&
+      existing.kind === 'cloud' &&
+      candidate.org === undefined &&
+      existing.org !== undefined
+        ? { org: existing.org }
+        : {})
+    }
+    connections = registry.connections.map(connection => (connection.id === existing.id ? selected : connection))
+  } else {
+    const label = uniqueLabel(
+      candidate.label,
+      registry.connections.map(connection => connection.label)
+    )
+    const id = connectionIdForLabel(
+      label,
+      registry.connections.map(connection => connection.id)
+    )
+
+    selected = { ...candidate, id, label }
+    connections = [...registry.connections, selected]
+  }
+
+  return {
+    ...registry,
+    connections,
+    primary: selected.id,
+    ...(options.activate ? { lastUsed: selected.id } : {})
+  }
+}
+
+/**
+ * Repair the partial migration produced when connections.json was first read
+ * while connection.json was still local, then a remote was configured later.
+ * Once the registry contains any non-local source it owns its multi-source
+ * shape and must not be overwritten by this compatibility repair.
+ */
+export function reconcileLocalOnlyRegistryFromV1(
+  registry: ConnectionRegistry,
+  v1: unknown
+): ConnectionRegistry {
+  if (registry.connections.some(connection => connection.kind !== 'local')) {
+    return registry
+  }
+
+  if (migratedGlobalConnection(v1).kind === 'local') {
+    return registry
+  }
+
+  return reconcileV1GlobalConnection(registry, v1, { activate: true })
+}
+
